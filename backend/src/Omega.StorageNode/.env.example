# ==========================================
# Omega Cloud Storage Node Configuration
# ==========================================

# Port exposed on the host
STORAGE_NODE_PORT=5001

# Path on the host to persist data & node-state.json
STORAGE_PATH=./data/storage

# Master Server Connection URL
MASTER_BASE_URL=http://master-server:5000

# Registration Token generated in Master Admin Panel (required on first launch)
NODE_REGISTRATION_KEY=node_reg_your_one_time_token_from_admin

# Optional: Direct Credential Override (if bypassing auto-registration)
# NODE_ID=00000000-0000-0000-0000-000000000000
# NODE_SECRET=your_32_byte_hex_secret_here

# Node Display Name
NODE_NAME=Home-NAS-Synology

# Public Node URL for direct browser transfers
# NOTE: If starts with https://..., direct Pre-signed transfers are active.
# If http:// or empty, Master automatically treats node as IsBehindNat = true (Proxy Fallback).
NODE_BASE_URL=https://nas.example.com:5001

# Force Proxy Mode (true / false). If omitted, automatically determined from NODE_BASE_URL.
# NODE_IS_BEHIND_NAT=false
