# Auto-detect text files and normalize line endings to LF in repository
* text=auto

# Linux shell scripts and Docker configs MUST use LF (prevents \r\n bad interpreter errors)
*.sh text eol=lf
Dockerfile* text eol=lf
Caddyfile text eol=lf
.env* text eol=lf

# Windows scripts
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Source code and web assets
*.cs text
*.ts text
*.html text
*.scss text
*.css text
*.json text
*.yml text
*.yaml text
*.md text

# Binary files
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.tar.gz binary
*.zip binary
