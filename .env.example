# =====================================================================
# 🌌 Omega Cloud — Environment Configuration Template (.env.example)
# =====================================================================

# --- СЕТЬ И ДОМЕН ---
# На боевом VPS: DOMAIN=cloud.example.com, CADDY_TLS=admin@example.com (email для Let's Encrypt)
# На домашнем ПК / локалке: DOMAIN=localhost, CADDY_TLS=internal (самоподписанный сертификат Caddy CA)
DOMAIN=localhost
CADDY_TLS=internal

# --- БАЗА ДАННЫХ POSTGRESQL ---
POSTGRES_DB=omega_cloud
POSTGRES_USER=omega_admin
POSTGRES_PASSWORD=generate_super_strong_secret_password_here
POSTGRES_PORT=5432

# --- MASTER BACKEND ---
ASPNETCORE_ENVIRONMENT=Production
JWT_SECRET=super_long_and_cryptographically_secure_jwt_secret_key_at_least_32_chars
JWT_ISSUER=OmegaCloudMaster
JWT_AUDIENCE=OmegaCloudClients
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# --- НАЧАЛЬНЫЙ АДМИНИСТРАТОР ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@omegacloud.local
ADMIN_PASSWORD=AdminPassword123!

# --- ПУТИ К ДАННЫМ НА ХОСТЕ ---
LOCAL_STORAGE_PATH=./data/storage
POSTGRES_DATA_PATH=./data/postgres
CADDY_DATA_PATH=./data/caddy
CADDY_CONFIG_PATH=./data/caddy_config
